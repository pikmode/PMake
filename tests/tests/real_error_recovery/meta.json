{
  "description": "fail → fix → только b.o + app",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 1,
        "files": [
          "a.o"
        ],
        "filesNot": [
          "b.o",
          "app"
        ]
      }
    },
    {
      "name": "fix_and_retry",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "modify": {
            "b.c": "int b;\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 2,
        "files": [
          "b.o",
          "app"
        ]
      }
    }
  ]
}
