{
  "description": "implicit: touch hdr → out rebuild (concat = new mtime)",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake",
    "-v"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 1,
        "files": [
          "out.txt"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_implicit",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "touch": [
            "hdr.txt"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    }
  ]
}
