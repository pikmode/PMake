{
  "description": "order-only: touch stamp.in → stamp rebuild, out skip",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake",
    "-v"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 2,
        "files": [
          "stamp.txt",
          "out.txt"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_order_only",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "touch": [
            "stamp.in"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1,
        "files": [
          "stamp.txt",
          "out.txt"
        ]
      }
    }
  ]
}
