{
  "description": "order-only + restat",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 2,
        "files": [
          "stamp.txt",
          "out.txt"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_stamp_skip",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "touch": [
            "stamp.in"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    },
    {
      "name": "modify_stamp_order_only_no_propagate",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "modify": {
            "stamp.in": "changed\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    }
  ]
}
