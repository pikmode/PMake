pmake_required_version = 1.0
python = "D:/bin/python3.exe"
mode = "debug"
switch mode {
case "debug" {
    rule echo { command = "${python} echo_to.py ${out} DEBUG" }
}
case "release" {
    rule echo { command = "${python} echo_to.py ${out} RELEASE" }
}
default {
    rule echo { command = "${python} echo_to.py ${out} UNKNOWN" }
}
}
build "out.txt" : echo
alias all : "out.txt"
