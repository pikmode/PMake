pmake_required_version = 1.0
python = "E:/python/python.exe"
rule cc {
    command = "${python} cc_make_dep.py ${in} ${out} common.h"
    depfile = "${out}.d"
    deps = "gcc"
    restat = true
}
rule link { command = "${python} concat.py ${out} ${in}" }
build "main.o" : cc "main.c"
build "app" : link "main.o"
alias all : "app"
