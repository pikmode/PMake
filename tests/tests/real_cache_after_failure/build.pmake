pmake_required_version = 1.0
python = "E:/python/python.exe"
rule cc {
    command = "${python} cc_maybe_fail.py ${in} ${out}"
}
rule link {
    command = "${python} concat.py ${out} ${in}"
}
build "f_01.o" : cc "f_01.c"
build "f_02.o" : cc "f_02.c"
build "f_03.o" : cc "f_03.c"
build "f_04.o" : cc "f_04.c"
build "f_05.o" : cc "f_05.c"
build "f_06.o" : cc "f_06.c"
build "f_07.o" : cc "f_07.c"
build "f_08.o" : cc "f_08.c"
build "f_09.o" : cc "f_09.c"
build "f_10.o" : cc "f_10.c"
build "f_11.o" : cc "f_11.c"
build "f_12.o" : cc "f_12.c"
build "f_13.o" : cc "f_13.c"
build "f_14.o" : cc "f_14.c"
build "f_15.o" : cc "f_15.c"
build "f_16.o" : cc "f_16.c"
build "f_17.o" : cc "f_17.c"
build "f_18.o" : cc "f_18.c"
build "f_19.o" : cc "f_19.c"
build "f_20.o" : cc "f_20.c"
build "f_21.o" : cc "f_21.c"
build "f_22.o" : cc "f_22.c"
build "f_23.o" : cc "f_23.c"
build "f_24.o" : cc "f_24.c"
build "f_25.o" : cc "f_25.c"
build "f_26.o" : cc "f_26.c"
build "f_27.o" : cc "f_27.c"
build "f_28.o" : cc "f_28.c"
build "f_29.o" : cc "f_29.c"
build "f_30.o" : cc "f_30.c"
build "app" : link "f_01.o" "f_02.o" "f_03.o" "f_04.o" "f_05.o" "f_06.o" "f_07.o" "f_08.o" "f_09.o" "f_10.o" "f_11.o" "f_12.o" "f_13.o" "f_14.o" "f_15.o" "f_16.o" "f_17.o" "f_18.o" "f_19.o" "f_20.o" "f_21.o" "f_22.o" "f_23.o" "f_24.o" "f_25.o" "f_26.o" "f_27.o" "f_28.o" "f_29.o" "f_30.o"
alias all : "app"