{
  "description": "pmake clean удаляет outputs",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "build_first",
      "expect": {
        "exit": 0,
        "taskCount": 1,
        "files": [
          "out.txt"
        ]
      }
    },
    {
      "name": "clean_cmd",
      "args": [
        "clean",
        "-f",
        "build.pmake"
      ],
      "expect": {
        "exit": 0,
        "filesNot": [
          "out.txt"
        ]
      }
    }
  ]
}
