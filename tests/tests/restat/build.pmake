pmake_required_version = 1.0
python = "D:/bin/python3.exe"
rule touch_always {
    command = "${python} restat.py ${out}"
    description = "RESTAT ${out}"
    restat = true
}
rule copy {
    command = "${python} copy.py ${in} ${out}"
}
build "mid.txt" : touch_always
build "final.txt" : copy "mid.txt"
alias all : "final.txt"
