pmake_required_version = 1.0
python = "E:/python/python.exe"
rule gen_once {
    command = "${python} touch.py ${out}"
    generator = true
}
rule check_stamp {
    command = "${python} check_stamp.py stamp.txt ${in} ${out}"
}
build "stamp.txt" : gen_once
build "out.txt" : check_stamp "out.in" || "stamp.txt"
alias all : "out.txt"
