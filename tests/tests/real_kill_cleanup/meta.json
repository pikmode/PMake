{
  "description": "Ctrl+C mid-build → restart completes",
  "bug": "",
  "timeoutSec": 90,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "kill_during",
      "args": [
        "-f",
        "build.pmake",
        "-j",
        "2"
      ],
      "kill_after_ms": 700,
      "continue": true,
      "expect": {}
    },
    {
      "name": "resume_after_kill",
      "before": [
        {
          "sleep": 0.5
        }
      ],
      "args": [
        "-f",
        "build.pmake",
        "-j",
        "2"
      ],
      "expect": {
        "exit": 0,
        "files": [
          "k_1.txt",
          "k_2.txt",
          "k_3.txt",
          "k_4.txt",
          "k_5.txt",
          "k_6.txt",
          "k_7.txt",
          "k_8.txt",
          "k_9.txt",
          "k_10.txt"
        ]
      }
    }
  ]
}
