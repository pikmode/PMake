{
  "description": "a.in → a.out → b.out → c.out",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 3,
        "files": [
          "a.out",
          "b.out",
          "c.out"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.5
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_a_in",
      "before": [
        {
          "sleep": 0.5
        },
        {
          "touch": [
            "a.in"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 3
      }
    }
  ]
}
