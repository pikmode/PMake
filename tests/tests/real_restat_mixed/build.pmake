pmake_required_version = 1.0
python = "E:/python/python.exe"
rule cp_restat {
    command = "${python} copy_preserve.py ${in} ${out}"
    restat = true
}
rule cp_plain {
    command = "${python} copy_preserve.py ${in} ${out}"
}
build "a.txt" : cp_restat "src.in"
build "b.txt" : cp_plain "a.txt"
alias all : "b.txt"
