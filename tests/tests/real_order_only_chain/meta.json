{
  "description": "order-only chain: touch s1 → только s1 rebuild",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake",
    "-v"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 3,
        "files": [
          "s1.txt",
          "s2.txt",
          "out.txt"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_s1",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "touch": [
            "s1.in"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    }
  ]
}
