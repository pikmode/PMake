pmake_required_version = 1.0
python = "E:/python/python.exe"
rule gen { command = "${python} echo_to.py ${out} MARKER_${marker}" }
build "p_1.txt" : gen { marker = "id_1" }
build "p_2.txt" : gen { marker = "id_2" }
build "p_3.txt" : gen { marker = "id_3" }
build "p_4.txt" : gen { marker = "id_4" }
build "p_5.txt" : gen { marker = "id_5" }
build "p_6.txt" : gen { marker = "id_6" }
build "p_7.txt" : gen { marker = "id_7" }
build "p_8.txt" : gen { marker = "id_8" }
build "p_9.txt" : gen { marker = "id_9" }
build "p_10.txt" : gen { marker = "id_10" }
build "p_11.txt" : gen { marker = "id_11" }
build "p_12.txt" : gen { marker = "id_12" }
build "p_13.txt" : gen { marker = "id_13" }
build "p_14.txt" : gen { marker = "id_14" }
build "p_15.txt" : gen { marker = "id_15" }
alias all : "p_1.txt", "p_2.txt", "p_3.txt", "p_4.txt", "p_5.txt", "p_6.txt", "p_7.txt", "p_8.txt", "p_9.txt", "p_10.txt", "p_11.txt", "p_12.txt", "p_13.txt", "p_14.txt", "p_15.txt"