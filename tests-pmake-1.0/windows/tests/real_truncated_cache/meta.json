{
  "description": "truncated cache → no crash",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 3,
        "files": [
          "a.out",
          "b.out",
          "app"
        ]
      }
    },
    {
      "name": "corrupt_cache",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "modify": {
            "Project-cache.pmake": "GARBAGE_CORRUPTED"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "taskCountMax": 3,
        "files": [
          "a.out",
          "b.out",
          "app"
        ]
      }
    },
    {
      "name": "recovered_noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    }
  ]
}
