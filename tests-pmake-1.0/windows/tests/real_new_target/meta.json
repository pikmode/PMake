{
  "description": "добавили build → только новый пересобирается",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 1,
        "files": [
          "a.out"
        ]
      }
    },
    {
      "name": "add_b_target",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "modify": {
            "build.pmake": "pmake_required_version = 1.0\npython = \"E:/python/python.exe\"\nrule copy { command = \"${python} copy.py ${in} ${out}\" }\nbuild \"a.out\" : copy \"a.in\"\nbuild \"b.out\" : copy \"b.in\"\nalias all : \"a.out\", \"b.out\"\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1,
        "files": [
          "b.out"
        ]
      }
    }
  ]
}
