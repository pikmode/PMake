pmake_required_version = 1.0
python = "E:/python/python.exe"
file = "src/core/main.cpp"
dir = dirname("${file}")
base = basename("${file}")
ext = extension("${file}")
joined = join("A", "B", "C", "-")
dir_base = basename("${dir}")
dir_parent = basename(dirname("${dir}"))
rule echo { command = "${python} write_all.py ${out} ${dir_parent} ${dir_base} ${base} ${ext} ${joined}" }
build "out.txt" : echo
alias all : "out.txt"
