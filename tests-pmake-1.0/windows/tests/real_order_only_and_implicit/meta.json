{
  "description": "implicit + order-only",
  "bug": "",
  "timeoutSec": 60,
  "args": [
    "-f",
    "build.pmake"
  ],
  "runs": [
    {
      "name": "first",
      "expect": {
        "exit": 0,
        "taskCount": 2,
        "files": [
          "stamp.txt",
          "out.txt"
        ]
      }
    },
    {
      "name": "noop",
      "before": [
        {
          "sleep": 0.3
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 0
      }
    },
    {
      "name": "touch_implicit",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "touch": [
            "hdr.txt"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    },
    {
      "name": "delete_stamp",
      "before": [
        {
          "sleep": 0.3
        },
        {
          "delete": [
            "stamp.txt"
          ]
        }
      ],
      "expect": {
        "exit": 0,
        "taskCount": 1
      }
    }
  ]
}
