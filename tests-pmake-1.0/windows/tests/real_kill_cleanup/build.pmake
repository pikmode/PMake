pmake_required_version = 1.0
python = "E:/python/python.exe"
rule slow {
    command = "${python} delayed_echo.py 300 ${out} content"
}
build "k_1.txt" : slow
build "k_2.txt" : slow
build "k_3.txt" : slow
build "k_4.txt" : slow
build "k_5.txt" : slow
build "k_6.txt" : slow
build "k_7.txt" : slow
build "k_8.txt" : slow
build "k_9.txt" : slow
build "k_10.txt" : slow
alias all : "k_1.txt", "k_2.txt", "k_3.txt", "k_4.txt", "k_5.txt", "k_6.txt", "k_7.txt", "k_8.txt", "k_9.txt", "k_10.txt"